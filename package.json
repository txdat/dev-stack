{
  "name": "dev-stack",
  "private": true,
  "type": "module",
  "description": "Plan-backed dev workflow for Claude Code, Pi, DeepSeek Harness, OpenCode, and Antigravity: rules, skills, phase gates, and /dev-stack-* commands",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "build:agy": "node scripts/build-agy.ts",
    "typecheck": "tsc -p tsconfig.engine.json && tsc -p tsconfig.node.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test --test-isolation=none 'test/**/*.test.ts'",
    "test:engine": "node scripts/test-engine.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:engine && npm run build"
  },
  "pi": {
    "extensions": [
      "./dist/dev/pi/dev.js"
    ],
    "skills": [
      "./dist/dev/skills"
    ]
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": "./dist/dev/dsh/index.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    ".claude-plugin",
    "cordis.patch.yml",
    "dist/dev",
    "icon.svg",
    "locale",
    "README.md"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@earendil-works/pi-coding-agent": "1.6.1",
    "@types/node": "24.19.4",
    "typescript": "7.0.2"
  }
}
