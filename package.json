{
  "name": "dev-stack",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc -p tsconfig.engine.json && tsc -p tsconfig.node.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test --test-isolation=none 'test/**/*.test.ts'",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "pi": {
    "extensions": [
      "./dist/dev/pi/dev.js"
    ],
    "skills": [
      "./dist/dev/skills"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
