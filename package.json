{
  "name": "dev-stack",
  "private": true,
  "type": "module",
  "description": "Plan-backed dev workflow for Claude Code, Pi, and DeepSeek Harness: rules, skills, phase gates, and /dev-stack-* commands",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc -p tsconfig.engine.json && tsc -p tsconfig.node.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test --timeout=0 test/",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build"
  },
  "pi": {
    "extensions": [
      "./dist/dev/pi/dev.js"
    ],
    "skills": [
      "./dist/dev/skills"
    ]
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": "./dist/dev/dsh/index.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    ".claude-plugin",
    "cordis.patch.yml",
    "dist/dev",
    "icon.svg",
    "locale",
    "README.md"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
